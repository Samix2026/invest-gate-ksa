{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Investment Licenses Dataset",
  "description": "Schema for the Invest Gate KSA investment licensing concepts dataset.",
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "language", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "title":         { "type": "string" },
        "description":   { "type": "string" },
        "language":      { "type": "string", "enum": ["en", "ar", "bilingual"] },
        "last_verified": { "type": "string" }
      }
    },
    "data": {
      "type": "array",
      "items": { "$ref": "#/definitions/license_entry" }
    }
  },
  "definitions": {
    "license_entry": {
      "type": "object",
      "required": [
        "id", "name", "name_alt", "abbreviation",
        "short_description", "issuing_authority",
        "applies_to", "depends_on", "common_confusions",
        "official_sources", "verification_status", "placeholders", "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id":                { "type": "string" },
        "name":              { "type": "string" },
        "name_alt":          { "type": "string" },
        "abbreviation":      { "type": ["string", "null"] },
        "short_description": { "type": "string" },
        "issuing_authority": {
          "type": "object",
          "required": ["name", "portal", "role"],
          "additionalProperties": false,
          "properties": {
            "name":   { "type": "string" },
            "portal": { "type": "string" },
            "role":   { "type": "string" }
          }
        },
        "applies_to": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "common_confusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "official_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "portal", "role"],
            "additionalProperties": false,
            "properties": {
              "name":   { "type": "string" },
              "portal": { "type": "string" },
              "role":   { "type": "string" }
            }
          }
        },
        "verification_status": {
          "type": "string",
          "enum": ["verified", "draft", "placeholder", "unverified"]
        },
        "placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "description", "verify_at"],
            "additionalProperties": false,
            "properties": {
              "field":       { "type": "string" },
              "description": { "type": "string" },
              "verify_at":   { "type": "string" }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "if": {
        "properties": { "verification_status": { "const": "draft" } },
        "required": ["verification_status"]
      },
      "then": {
        "properties": { "placeholders": { "minItems": 1 } }
      }
    }
  }
}
