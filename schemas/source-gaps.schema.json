{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "invest-gate-ksa/schemas/source-gaps.schema.json",
  "title": "Source Gaps Dataset — Invest Gate KSA",
  "description": "Validates source-gaps.en.json and source-gaps.ar.json. Tracks official authorities referenced in other datasets that do not yet have a verified entry in data/sources.en.json.",
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,

  "properties": {

    "meta": {
      "type": "object",
      "required": ["title", "description", "language", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "title":         { "type": "string", "minLength": 1 },
        "description":   { "type": "string", "minLength": 1 },
        "language":      { "type": "string", "enum": ["en", "ar"] },
        "last_verified": { "type": "string", "minLength": 1 }
      }
    },

    "data": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source_gap" }
    }

  },

  "definitions": {

    "source_gap": {
      "type": "object",
      "required": [
        "id",
        "name",
        "name_alt",
        "mentioned_in_datasets",
        "reason_needed",
        "likely_official_domain",
        "verification_status",
        "next_verification_step",
        "placeholders",
        "tags"
      ],
      "additionalProperties": false,

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable machine-readable identifier. Identical across language files."
        },

        "name":     { "type": "string", "minLength": 1 },
        "name_alt": { "type": "string", "minLength": 1 },

        "mentioned_in_datasets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Dataset names (without language suffix) that reference this authority."
        },

        "reason_needed": {
          "type": "string",
          "minLength": 1,
          "description": "Why this authority needs a verified entry in data/sources.en.json."
        },

        "likely_official_domain": {
          "type": "string",
          "minLength": 1,
          "description": "Unverified likely domain for the authority. Must be confirmed before creating a sources entry."
        },

        "verification_status": {
          "type": "string",
          "enum": ["draft", "verified"]
        },

        "next_verification_step": {
          "type": "string",
          "minLength": 1,
          "description": "Specific action needed to close this gap."
        },

        "placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "description", "verify_at"],
            "additionalProperties": false,
            "properties": {
              "field":       { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "verify_at":   { "type": "string", "minLength": 1 }
            }
          }
        },

        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }

      },

      "if": {
        "properties": { "verification_status": { "const": "draft" } },
        "required": ["verification_status"]
      },
      "then": {
        "properties": { "placeholders": { "minItems": 1 } }
      }

    }

  }
}
