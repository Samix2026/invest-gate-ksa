{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "invest-gate-ksa/schemas/sectors.schema.json",
  "title": "Sectors Dataset — Invest Gate KSA",
  "description": "Validates sectors.en.json and sectors.ar.json. Covers sectors relevant to foreign investors in Saudi Arabia — descriptive and contextual only, not regulatory guidance.",
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,

  "properties": {

    "meta": {
      "type": "object",
      "required": ["title", "description", "language", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "title":         { "type": "string", "minLength": 1 },
        "description":   { "type": "string", "minLength": 1 },
        "language":      { "type": "string", "enum": ["en", "ar"] },
        "last_verified": { "type": "string", "minLength": 1 }
      }
    },

    "data": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sector_entry" }
    }

  },

  "definitions": {

    "sector_entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "name_alt",
        "short_description",
        "typical_business_models",
        "likely_authorities",
        "related_license_concepts",
        "regulatory_sensitivity",
        "common_confusions",
        "official_sources",
        "verification_status",
        "placeholders",
        "tags",
        "vision2030_priority",
        "vision2030_target_en",
        "vision2030_target_ar",
        "fdi_target_usd_billion",
        "supervising_vision_entity_en",
        "supervising_vision_entity_ar",
        "vision2030_verification_status",
        "vision2030_verify_at"
      ],
      "additionalProperties": false,

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable machine-readable identifier. Identical across language files."
        },

        "name":              { "type": "string", "minLength": 1 },
        "name_alt":          { "type": "string", "minLength": 1 },
        "short_description": { "type": "string", "minLength": 1 },

        "typical_business_models": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },

        "likely_authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "role"],
            "additionalProperties": false,
            "properties": {
              "id":   { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },

        "related_license_concepts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },

        "regulatory_sensitivity": {
          "type": "string",
          "enum": ["standard", "regulated", "highly_regulated", "restricted"]
        },

        "common_confusions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },

        "official_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "role", "portal"],
            "additionalProperties": false,
            "properties": {
              "name":   { "type": "string", "minLength": 1 },
              "role":   { "type": "string", "minLength": 1 },
              "portal": { "type": "string", "minLength": 1 }
            }
          }
        },

        "verification_status": {
          "type": "string",
          "enum": ["draft", "verified"]
        },

        "placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "description", "verify_at"],
            "additionalProperties": false,
            "properties": {
              "field":       { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "verify_at":   { "type": "string", "minLength": 1 }
            }
          }
        },

        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },

        "vision2030_priority": {
          "type": "string",
          "enum": ["critical", "high", "medium", "supporting"],
          "description": "Priority tier in Vision 2030 National Investment Strategy"
        },
        "vision2030_target_en": {
          "type": ["string", "null"],
          "description": "Official Vision 2030 target for this sector (English)"
        },
        "vision2030_target_ar": {
          "type": ["string", "null"],
          "description": "Official Vision 2030 target for this sector (Arabic)"
        },
        "fdi_target_usd_billion": {
          "type": ["number", "null"],
          "description": "FDI target in USD billions if officially published"
        },
        "supervising_vision_entity_en": {
          "type": ["string", "null"],
          "description": "Primary Vision 2030 program or entity overseeing this sector"
        },
        "supervising_vision_entity_ar": {
          "type": ["string", "null"],
          "description": "Arabic equivalent"
        },
        "vision2030_verification_status": {
          "type": "string",
          "enum": ["verified", "draft", "not_applicable"]
        },
        "vision2030_verify_at": {
          "type": ["string", "null"]
        }

      },

      "if": {
        "properties": { "verification_status": { "const": "draft" } },
        "required": ["verification_status"]
      },
      "then": {
        "properties": { "placeholders": { "minItems": 1 } }
      }

    }

  }
}
