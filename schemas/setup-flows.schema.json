{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Setup Flows Schema",
  "description": "Conceptual setup flows for common foreign investment scenarios in Saudi Arabia. All flows are architectural and informational only — not procedural instructions, legal requirements, or approval guarantees.",
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "language", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "title":         { "type": "string", "minLength": 1 },
        "description":   { "type": "string", "minLength": 1 },
        "language":      { "type": "string", "enum": ["en", "ar"] },
        "last_verified": { "type": "string", "minLength": 1 }
      }
    },
    "data": {
      "type": "array",
      "items": { "$ref": "#/definitions/flow_entry" }
    }
  },
  "definitions": {
    "authority_ref": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id":   { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "placeholder": {
      "type": "object",
      "required": ["field", "description", "verify_at"],
      "additionalProperties": false,
      "properties": {
        "field":       { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "verify_at":   { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "required": ["step_number", "label", "description", "authority", "depends_on_step"],
      "additionalProperties": false,
      "properties": {
        "step_number":    { "type": "integer", "minimum": 1 },
        "label":          { "type": "string", "minLength": 1 },
        "description":    { "type": "string", "minLength": 1 },
        "authority": {
          "oneOf": [
            { "$ref": "#/definitions/authority_ref" },
            { "type": "null" }
          ]
        },
        "depends_on_step": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "notes": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "decision_point": {
      "type": "object",
      "required": ["at_step", "question", "options"],
      "additionalProperties": false,
      "properties": {
        "at_step":  { "type": "integer", "minimum": 1 },
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        }
      }
    },
    "related_authority": {
      "type": "object",
      "required": ["id", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "id":   { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "source_dependency": {
      "type": "object",
      "required": ["dataset", "entry_id", "description"],
      "additionalProperties": false,
      "properties": {
        "dataset":     { "type": "string", "minLength": 1 },
        "entry_id":    { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "flow_entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "name_alt",
        "short_description",
        "target_investor_type",
        "related_sectors",
        "steps",
        "decision_points",
        "related_authorities",
        "source_dependencies",
        "verification_status",
        "placeholders",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "name_alt": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "short_description": {
          "type": "string",
          "minLength": 1
        },
        "target_investor_type": {
          "type": "string",
          "minLength": 1
        },
        "related_sectors": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" },
          "minItems": 1
        },
        "decision_points": {
          "type": "array",
          "items": { "$ref": "#/definitions/decision_point" }
        },
        "related_authorities": {
          "type": "array",
          "items": { "$ref": "#/definitions/related_authority" },
          "minItems": 1
        },
        "source_dependencies": {
          "type": "array",
          "items": { "$ref": "#/definitions/source_dependency" }
        },
        "verification_status": {
          "type": "string",
          "enum": ["draft", "verified"]
        },
        "placeholders": {
          "type": "array",
          "items": { "$ref": "#/definitions/placeholder" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "if": {
        "properties": {
          "verification_status": { "const": "draft" }
        }
      },
      "then": {
        "properties": {
          "placeholders": { "minItems": 1 }
        }
      }
    }
  }
}
