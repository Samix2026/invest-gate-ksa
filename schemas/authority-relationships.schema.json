{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Authority Relationships Schema",
  "description": "Conceptual relationships between regulatory authorities in the Saudi investment context",
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "language", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "title":         { "type": "string", "minLength": 1 },
        "description":   { "type": "string", "minLength": 1 },
        "language":      { "type": "string", "enum": ["en", "ar"] },
        "last_verified": { "type": "string", "minLength": 1 }
      }
    },
    "data": {
      "type": "array",
      "items": { "$ref": "#/definitions/relationship_entry" }
    }
  },
  "definitions": {
    "authority_ref": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id":   { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "placeholder": {
      "type": "object",
      "required": ["field", "description", "verify_at"],
      "additionalProperties": false,
      "properties": {
        "field":       { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "verify_at":   { "type": "string", "minLength": 1 }
      }
    },
    "relationship_entry": {
      "type": "object",
      "required": [
        "id",
        "from_authority",
        "to_authority",
        "relationship_type",
        "relationship_direction",
        "conceptual_description",
        "applies_to_sectors",
        "examples",
        "verification_status",
        "placeholders",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "from_authority": { "$ref": "#/definitions/authority_ref" },
        "to_authority": {
          "oneOf": [
            { "$ref": "#/definitions/authority_ref" },
            { "type": "null" }
          ]
        },
        "relationship_type": {
          "type": "string",
          "enum": [
            "foundational_dependency",
            "operational_dependency",
            "sector_oversight",
            "compliance_interaction",
            "infrastructure_relationship",
            "strategic_coordination"
          ]
        },
        "relationship_direction": {
          "type": "string",
          "enum": ["unidirectional", "bidirectional", "contextual"]
        },
        "conceptual_description": {
          "type": "string",
          "minLength": 1
        },
        "applies_to_sectors": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verification_status": {
          "type": "string",
          "enum": ["draft", "verified"]
        },
        "placeholders": {
          "type": "array",
          "items": { "$ref": "#/definitions/placeholder" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "if": {
        "properties": {
          "verification_status": { "const": "draft" }
        }
      },
      "then": {
        "properties": {
          "placeholders": { "minItems": 1 }
        }
      }
    }
  }
}
